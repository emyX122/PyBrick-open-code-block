{
  "version": "0.1",
  "manifest_version": 3,
  "name": "PybrickCodeBlock Extensions",
  "description": "Pybrick Extension for free block coding",
  "permissions": ["activeTab"],
  "host_permissions": ["https://beta.pybricks.com/*"],
  "action": {
    "default_popup": "popup/html/popup.html",
    "default_icon": "assets/images/pybrickCodeBlock.png"
  },
  "content_scripts": [
    {
      "matches": ["https://beta.pybricks.com/*"],
      "js": [
        "initialSetup/js/initialisationVariables.js",
        "initialSetup/js/basicRemover.js", 
        "initialSetup/js/SwitchCodeMode.js",
        "initialSetup/js/injected.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "assets/images/PyBlock.png", 

        "assets/images/PyBrickIcoSwitchButton.svg",
        "assets/images/sponsorButton.svg",
        "assets/images/blockMode/*",

        "assets/images/blockMode/blocks/*",

        "src/html/panelBlockMode.html",
        "src/html/sponsorModal.html"
      ],
      "matches": ["<all_urls>"]
    }
  ]
}