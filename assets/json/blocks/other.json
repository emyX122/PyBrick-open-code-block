        "import": [
            {
                "from": "pybricks.parameters",
                "import": [
                    "Button"
                ]
            }
        ],
        "code": [{
            "code": "$A.system.set_stop_button($B)"
        }],
        "connection": [{
            "type": "code",
            "input": true,
            "output": true
        }],
        "content": [
            {
                "type": "number",
                "input": true,
                "selector": [],
                "linkDevice": [
                    "hub"
                ],
                "text": "HUB",
                "variable": "$A",
                "code": "content-value"
            },
            {
                "type": "text",
                "text": "stop button is"
            },
            {
                "type": "number",
                "input": true,
                "selector": [
                    {
                        "option": "none",
                        "selected": true,
                        "value": "None"
                    },
                    {
                        "option": "center",
                        "value": "Button.CENTER"
                    },
                    {
                        "option": "left",
                        "value": "Button.LEFT"
                    },
                    {
                        "option": "right",
                        "value": "Button.RIGHT"
                    },
                    {
                        "option": "bluetooth",
                        "value": "Button.BLUETOOTH"
                    }
                ],
                "variable": "$B",
                "code": "content-value"
            }
        ]
    }],

