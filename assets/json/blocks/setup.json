    "6": [{
        "version": 1.0,
        "name": "simpleMotor",
        "class": "output",
        "categorie": "setup",
        "submenu": "Set smart motors",
        "icon": "simpleMotor",
        "connection": [{
            "type": "setup",
            "input": true,
            "output": true
        }],
        "import": [
            {
                "from": "pybricks.parameters",
                "import": [
                    "Direction", 
                    "Port"
                ]
            }
        ],
        "code": [{
            "setup": "$A = Motor(Port.$B, Direction.$C)"
        }],
        "content": [
            {
                "type": "text",
                "input": true,
                "text": "motor",
                "variable": "$A",
                "code": "content-text"
            },
            {
                "type": "text",
                "text": "on"
            },
            {
                "type": "number",
                "input": true,
                "selector": [
                    {
                        "option": "port A",
                        "subtext": "A",
                        "selected": true,
                        "value": "A"
                    },
                    {
                        "option": "port B",
                        "subtext": "B",
                        "value": "B"
                    },
                    {
                        "option": "port C",
                        "subtext": "C",
                        "value": "C"
                    },
                    {
                        "option": "port D",
                        "subtext": "D",
                        "value": "D"
                    },
                    {
                        "option": "port E",
                        "subtext": "E",
                        "value": "E"
                    },
                    {
                        "option": "port F",
                        "subtext": "F",
                        "value": "F"
                    }
                ],
                "variable": "$B",
                "code": "content-value"
            },
            {
                "type": "text",
                "text": "with forward"
            },
            {
                "type": "number",
                "input": true,
                "selector": [
                    {
                        "option": "↻ clockwise",
                        "subtext": "↻",
                        "selected": true,
                        "value": "CLOCKWISE"
                    },
                    {
                        "option": "↺ anticlockwise",
                        "subtext": "↺",
                        "value": "COUNTERCLOCKWISE"
                    }
                ],
                "variable": "$C",
                "code": "content-value"
            }
        ]
    }],

